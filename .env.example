# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=trading-bolt
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# ── Database (PostgreSQL) ───────────────────────────────────────────
POSTGRES_USER=bolt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading_bolt
POSTGRES_PORT=5432
# Fail-closed: a non-local DATABASE_URL (including Neon) is refused outside
# NODE_ENV=production, so development can never silently write to a remote
# production database. Use local Postgres for development.
DATABASE_URL=postgres://bolt:changeme@localhost:5432/trading_bolt
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ───────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth (Phase 1+; placeholders only) ──────────────────────────────
JWT_SECRET=generate-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

ENCRYPTION_KEY=

# ── Market Data (Phase 2) ────────────────────────────────────────────
# Optional; defaults to the public Bybit spot API.
MARKET_DATA_BASE_URL=https://api.bybit.com

# ── Binance (Phase 8+; placeholders only — never commit real values) ─
# Primary development exchange. BINANCE_ENV must be 'testnet' outside
# production; mainnet is refused unless NODE_ENV=production (fail-closed).
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Bybit (Phase 8+; optional fallback — placeholders only) ─────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENVIRONMENT=demo

# ── AI (Phase 11+) ──────────────────────────────────────────────────
AI_API_KEY=
